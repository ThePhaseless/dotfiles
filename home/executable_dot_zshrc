#!/usr/bin/zsh
GITHUB_USERNAME="ThePhaseless"

# Disable Aloy "magic enter"
ALOY_MAGICENTER=()
bindkey '^M' accept-line

# zsh-autocomplete and other plugins need a valid TERM. Provide a safe default
# when the terminal emulator did not set one (e.g., some IDE terminals).
[[ -z "$TERM" ]] && export TERM=xterm-256color

export _ZO_EXCLUDE_DIRS="!(@(node_modules|dist))"
export DISABLE_AUTO_UPDATE="true"

if [[ -n $INTELLIJ_ENVIRONMENT_READER || -n $VSCODE_RESOLVING_ENVIRONMENT ]]; then
    return 0
fi

[[ -o interactive ]] || return 0

init_chezmoi() {
    if ! command -v chezmoi &>/dev/null; then
        return
    fi

    # Only init if the repo doesn't exist; skip the synchronous update to save startup time
    if [ ! -d "$HOME/.local/share/chezmoi" ]; then
        (cd "$HOME" && sh -c "$(curl -fsLS get.chezmoi.io/lb)" -- init --apply "$GITHUB_USERNAME")
    fi
}

init_antidote() {
    local antidote_dir="$HOME/.antidote"
    local plugins_txt="$HOME/.zsh_plugins.txt"
    local plugins_zsh="$HOME/.zsh_plugins.zsh"

    if [[ ! -f "$plugins_txt" ]]; then
        return 0
    fi

    if [[ ! -d "$antidote_dir" ]]; then
        update_repo "https://github.com/mattmc3/antidote.git" "$antidote_dir" || return 1
    fi

    if [[ ! -f "$antidote_dir/antidote.zsh" ]]; then
        echo "antidote install appears broken, skipping plugins"
        return 1
    fi

    if [[ ! -s "$plugins_zsh" ]] || [[ "$plugins_txt" -nt "$plugins_zsh" ]]; then
        (
            source "$antidote_dir/antidote.zsh"
            antidote bundle < "$plugins_txt" > "$plugins_zsh"
            zcompile "$plugins_zsh" # Pre-compile to binary for maximum speed
        )
    fi

    if [[ -s "$plugins_zsh" ]]; then
        source "$plugins_zsh"
    else
        echo "antidote plugin file is empty or missing, skipping"
        return 1
    fi
}

init_locale() {
    if ! locale -a | grep -qE "en_US\.(utf|UTF)-?8"; then
        echo "Locale missing! Please run manually: sudo locale-gen en_US.UTF-8"
    fi

    if ! echo "$LANG" | grep -qE "en_US\.(utf|UTF)-?8"; then
        export LANG="en_US.UTF-8"
    fi
}

init_docker() {
    # WSL: Docker Desktop may not be running even if the docker binary is in
    # PATH. The /var/run/docker.sock check is fast; fall back to docker --version
    # only when the socket is missing. If docker is unavailable, skip the plugin
    # silently and avoid shell startup errors.
    if [[ ! -S /var/run/docker.sock ]] && ! command docker --version >/dev/null 2>&1; then
        return 0
    fi

    local plugin="$HOME/.cache/antidote/github.com/ohmyzsh/ohmyzsh/plugins/docker/docker.plugin.zsh"
    if [[ -f "$plugin" ]]; then
        source "$plugin"
    fi
}

update_repo() {
    if ! command -v git &>/dev/null; then
        echo "git not found, skipping repo update for $1"
        return 1
    fi

    local repo_url=$1
    local output_path=$2
    local repo_name=$(basename "$1" .git)
    repo_name=${repo_name#.}

    if [ -z "$output_path" ]; then
        output_path=$HOME/.${repo_name}
    fi

    if [ -d "$output_path" ]; then
        git -qC "$output_path" pull
    else
        git clone --depth=1 "$repo_url" "$output_path"
    fi
}

bind_keys() {
    bindkey '^I' menu-select                                          # TAB
    bindkey -M menuselect '^I' menu-complete                          # TAB
    [[ -n "${terminfo[kcbt]}" ]] && bindkey "${terminfo[kcbt]}" menu-select                           # shift-tab
    [[ -n "${terminfo[kcbt]}" ]] && bindkey -M menuselect "${terminfo[kcbt]}" reverse-menu-complete   # shift-tab
    bindkey -M menuselect '^[[D' .backward-char '^[OD' .backward-char # arrow left
    bindkey -M menuselect '^[[C' .forward-char '^[OC' .forward-char   # arrow right
}

error_occurred=0
fpath+=( "$HOME/.cache/zsh/completions" )

init_locale || error_occurred=1
init_chezmoi || error_occurred=1
init_antidote || error_occurred=1
init_docker || error_occurred=1

# Aloy rebinds Enter during theme init; restore plain submit after plugins load.
bindkey -M main '^M' accept-line

if [[ $error_occurred -ne 0 ]]; then
    echo "An error occurred during initialization. Clearing antidote cache... Please check the output above."
    rm -f "$HOME/.zsh_plugins.zsh"
fi

bind_keys

function safe_smartcache() {
    local subcmd="$1"; shift
    local binary="$1"
    if ! (( $+functions[smartcache] )); then
        return 0
    fi
    # Use command -v instead of $+commands to avoid building the full
    # command hash table across a large PATH on every shell start.
    if command -v "$binary" >/dev/null 2>&1; then
        smartcache "$subcmd" "$@" 2>/dev/null
    fi
}

safe_smartcache comp gh completion -s zsh
safe_smartcache comp chezmoi completion zsh
safe_smartcache comp uv generate-shell-completion zsh
safe_smartcache comp uvx --generate-shell-completion zsh
safe_smartcache comp ng completion script zsh
safe_smartcache eval direnv hook zsh
safe_smartcache eval zoxide init zsh --no-cmd

# Activate mise for zsh. The output is cached by smartcache; on cache hit it is
# sourced instantly. The initial `_mise_hook --force` call stays: it applies
# mise's environment before the first prompt, so `zsh -ic` matches the
# non-interactive shells that get it from ~/.env.
# `env -i` gives the command a clean, deterministic environment so that the
# cache does not keep invalidating itself because the parent shell already
# loaded mise and exported MISE_* / __MISE_* variables.
# That clean PATH leaks into the output as `export PATH=` / `__MISE_ORIG_PATH=`
# lines; they are stripped so the shell keeps its own PATH.
safe_smartcache eval env -i HOME="$HOME" TERM=xterm-256color PATH=/usr/bin:/bin zsh -c 'source ~/.env; rehash; mise activate zsh | sed -E -e "/^export (__MISE_ORIG_)?PATH=/d"'

# Registered after mise's prompt and cd hooks, which re-prepend its tools ahead of ~/.local/bin.
if (( $+functions[_dotenv_local_bin_first] )); then
    add-zsh-hook precmd _dotenv_local_bin_first
    add-zsh-hook chpwd _dotenv_local_bin_first
    _dotenv_local_bin_first
fi

[[ -n $HOMEBREW_PREFIX ]] && fpath[1,0]="$HOMEBREW_PREFIX/share/zsh/site-functions"

# Custom cd wrapper to suppress error if already in target directory
function cd() {
    if ! (( $+functions[__zoxide_z] )); then
        builtin cd "$@"
        return $?
    fi
    __zoxide_z "$@"
    local ret=$?
    if [[ $ret -ne 0 ]]; then
        local target
        if [[ -z $@ ]]; then
            target="$HOME"
        else
            target="$(zoxide query "$@" 2>/dev/null)"
        fi
        if [[ $target == "$PWD" ]]; then
            return 0
        fi
    fi
    return $ret
}

# Only deactivates venvs it activated itself, so a manually sourced venv sticks.
# Paths are compared resolved because /home is a symlink to /var/home here.
function autovenv() {
    local dir=${PWD:A} venv=
    while [[ -n $dir ]]; do
        if [[ -f $dir/.venv/bin/activate ]]; then
            venv=$dir/.venv
            break
        fi
        dir=${dir%/*}
    done

    [[ -n ${VIRTUAL_ENV:-} && $venv == "${VIRTUAL_ENV:A}" ]] && return

    if [[ -n ${_AUTOVENV:-} && ${VIRTUAL_ENV:-} == "$_AUTOVENV" ]] && (( $+functions[deactivate] )); then
        deactivate
        unset _AUTOVENV
    fi

    if [[ -n $venv && -z ${VIRTUAL_ENV:-} ]]; then
        source "$venv/bin/activate"
        _AUTOVENV=$VIRTUAL_ENV
    fi
}

# VIRTUAL_ENV inherited from a parent process (IDE, agent) has no deactivate
# function here and would block autovenv forever.
if [[ -n ${VIRTUAL_ENV:-} ]] && ! (( $+functions[deactivate] )); then
    path=( ${path:#$VIRTUAL_ENV/bin} )
    unset VIRTUAL_ENV VIRTUAL_ENV_PROMPT
fi
autoload -Uz add-zsh-hook
add-zsh-hook chpwd autovenv
autovenv

if [[ $error_occurred -ne 0 ]]; then
    echo "An error occurred during initialization. Please check the output above."
fi

if [ -f /var/run/motd.dynamic ]; then
    reset
    cat /var/run/motd.dynamic
fi

## Start async chezmoi auto-updater (Rate-limited to once per hour)
# It runs detached from the terminal, so it can never stop on a prompt. It
# writes a notice only when it changed files in ~ or found a conflict; the
# notice shows once in every shell started before it, at the next prompt or as
# soon as the update finishes while this shell sits at the prompt.
zmodload -F zsh/stat b:zstat
zmodload zsh/datetime
_dotfiles_updater="$HOME/.local/share/chezmoi/chezmoi-auto-update.sh"
_dotfiles_state="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi-auto-update"
typeset -g _dotfiles_seen=$EPOCHSECONDS _dotfiles_conflicts_shown=

dotfiles-resolve() { bash "$_dotfiles_updater" resolve; }

# Set reply to the lines not yet shown in this shell.
_dotfiles_pending() {
    reply=()
    local -a mtime
    if zstat -A mtime +mtime -- $_dotfiles_state/notice 2>/dev/null && (( mtime[1] >= _dotfiles_seen )); then
        _dotfiles_seen=$(( mtime[1] + 1 ))
        reply+=("${(%):-%F{cyan\}[dotfiles]%f} $(<$_dotfiles_state/notice)")
    fi
    local conflicts=
    [[ -s $_dotfiles_state/conflicts ]] && conflicts=$(<$_dotfiles_state/conflicts)
    if [[ -n $conflicts && $conflicts != $_dotfiles_conflicts_shown ]]; then
        reply+=("${(%):-%F{yellow\}[dotfiles]%f} not applied, changed both in ~ and in the repo: ~/${(pj:, ~/:)${(f)conflicts}}. Run: dotfiles-resolve")
    fi
    _dotfiles_conflicts_shown=$conflicts
}

_dotfiles_precmd() {
    local -a reply
    _dotfiles_pending
    (( $#reply )) && print -rl -- $reply
}
add-zsh-hook precmd _dotfiles_precmd

# Called by zle when the updater exits while this shell waits at the prompt.
# With text on the command line it prints nothing; precmd shows the notice
# after that command instead, so it never lands in the middle of typing.
_dotfiles_done() {
    local fd=$1
    zle -F $fd
    exec {fd}<&-
    [[ -z $BUFFER ]] || return 0
    local -a reply
    _dotfiles_pending
    if (( $#reply )); then
        zle -I
        print -rl -- $reply
    fi
}

if command -v bash >/dev/null 2>&1 && [[ -f $_dotfiles_updater ]]; then
    local update_marker="/tmp/.chezmoi_last_update"

    if [[ ! -f "$update_marker" ]] || [[ -z $(find "$update_marker" -mmin -60 2>/dev/null) ]]; then
        touch "$update_marker"
        mkdir -p $_dotfiles_state
        local -a _dotfiles_run=(bash $_dotfiles_updater)
        (( $+commands[setsid] )) && _dotfiles_run=(setsid -w $_dotfiles_run)
        # The pipe closes when the updater exits, which wakes _dotfiles_done. The
        # trailing `:` keeps the subshell that holds the pipe alive until then.
        local _dotfiles_fd
        exec {_dotfiles_fd}< <($_dotfiles_run </dev/null >$_dotfiles_state/log 2>&1; :)
        zle -N _dotfiles_done
        zle -F -w $_dotfiles_fd _dotfiles_done
    fi
fi
