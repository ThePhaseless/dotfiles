#!/bin/sh
# node -> bun shim, so tools that hardcode `node` (e.g. plugin hooks) run on Bun without Node.
# If a real node exists later in PATH (Node installed), defer to it.
here=$(dirname "$(readlink -f "$0")")
IFS=:
for d in $PATH; do
	[ "$(readlink -f "$d")" = "$here" ] && continue
	[ -x "$d/node" ] && exec "$d/node" "$@"
done
unset IFS

exec bun "$@"
