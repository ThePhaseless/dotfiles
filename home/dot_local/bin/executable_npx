#!/bin/sh
# npx -> bunx shim, so tools that hardcode `npx` (e.g. plugin MCP servers) run on Bun without Node.
# If a real npx exists later in PATH (Node installed), defer to it.
here=$(dirname "$(readlink -f "$0")")
IFS=:
for d in $PATH; do
	[ "$(readlink -f "$d")" = "$here" ] && continue
	[ -x "$d/npx" ] && exec "$d/npx" "$@"
done
unset IFS

# bunx installs without asking, so npx's confirmation flags are dropped
for a in "$@"; do
	shift
	case $a in -y | --yes) ;; *) set -- "$@" "$a" ;; esac
done
exec bunx "$@"
