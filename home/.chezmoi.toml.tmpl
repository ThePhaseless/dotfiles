{{- $gitEmail := promptStringOnce . "gitEmail" "Git user email" "kukubaorch@gmail.com" -}}
{{- $gitName := promptStringOnce . "gitName" "Git user name" "ThePhaseless" -}}

[git]
autoAdd = true
autoCommit = true
autoPush = true
commitMessageTemplate = {{`"{{ promptString \"Commit message\" }}"`}}

[data]
    gitEmail = {{ $gitEmail | quote }}
    gitName = {{ $gitName | quote }}

[edit]
apply = true
watch = true

# Merge in the same GUI editor as $EDITOR (see dot_env.tmpl) instead of vimdiff.
# The merge result is the source file: edit and save it, then close the tab.
{{- if lookPath "zed" }}

[merge]
command = "zed"
args = ["--wait", "--diff", {{`"{{ .Destination }}"`}}, {{`"{{ .Source }}"`}}]
{{- else if lookPath "code" }}

[merge]
command = "bash"
args = ["-c", {{`"cp '{{ .Target }}' '{{ .Target }}.base' && code --new-window --wait --merge '{{ .Destination }}' '{{ .Target }}' '{{ .Target }}.base' '{{ .Source }}'"`}}]
{{- end }}
